<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>jp.workwith</groupId>
    <artifactId>work-with</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>work-with</name>
    <description>オンラインワークスペースアプリ「ワークwith」のバックエンド</description>

    <properties>
        <java.version>21</java.version>
        <sqlite-jdbc.version>3.53.2.0</sqlite-jdbc.version>
    </properties>

    <dependencies>
        <!-- REST APIなどのWeb機能を追加するための依存関係です。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- JdbcTemplateを使ってデータベースを操作します。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- JavaからSQLiteへ接続するためのJDBCドライバです。 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <!-- 認証機能全体は導入せず、パスワードのBCryptハッシュ化だけに使用します。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- 既存フロントエンドを移動せず、Spring Bootから配信できるようにします。 -->
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>static</targetPath>
                <includes>
                    <include>main.html</include>
                    <include>css/**</include>
                    <include>js/**</include>
                    <include>work-space-pic/**</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
